# Copia este archivo como .env.local y llena los valores de tu proyecto de
# Supabase (Project Settings → API). La "publishable/anon key" es pública por
# diseño: la seguridad la ponen las políticas RLS de la base de datos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-publishable-key
